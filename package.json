{
  "name": "get-gradle-versions",
  "private": true,
  "description": "Expose latest Gradle versions for an action",
  "scripts": {
    "build": "ncc build src/main.ts --target es2022",
    "format": "prettier --write **/*.ts",
    "format-check": "prettier --check **/*.ts",
    "lint": "eslint src/**/*.ts",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KyoriPowered/get-gradle-versions.git"
  },
  "keywords": [
    "gradle",
    "java",
    "actions",
    "github"
  ],
  "author": "KyoriPowered",
  "license": "GNU Lesser General Public License, version 3.0",
  "packageManager": "yarn@4.9.4",
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/eslint": "^8.44.8",
    "@types/jest": "^30.0.0",
    "@types/node": "20.19.11",
    "@vercel/ncc": "^0.38.1",
    "eslint": "^9.0.0",
    "eslint-plugin-jest": "^29.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^30.0.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.2",
    "typescript-eslint": "^8.41.0"
  },
  "dependencies": {
    "@actions/core": "^1.10.1"
  }
}
